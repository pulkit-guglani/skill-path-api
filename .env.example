# Server (Railway/Render set PORT automatically)
PORT=8000

# PostgreSQL — local dev
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/skill_path?schema=public"

# PostgreSQL — Neon production example
# DATABASE_URL="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/skill_path?sslmode=require"

# Gemini (roadmap generation)
GEMINI_API_KEY=
# Model priority is hardcoded in src/gemini/gemini.service.ts
# Set to true for local dev without an API key (returns a static Chess fixture)
GEMINI_MOCK=false

# YouTube Data API v3 — used to find real tutorial videos per skill
# Enable "YouTube Data API v3" in Google Cloud Console, create an API key
YOUTUBE_API_KEY=
